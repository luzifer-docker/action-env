{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}custom.latestver{{/if}}",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "(:?[A-Z]+_)?VERSION=(?<currentValue>.*?)\\s+# renovate: packageName=(?<packageName>.+?)(?:\\s+datasource=(?<datasource>.+?))?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "goinst\\s+(?<depName>[^\\s@]+)@(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "extends": [
    "https://git.luzifer.io/luzifer/renovate-config/raw/branch/master/default.json"
  ]
}